{
  "model": "opus",
  "enabledMcpjsonServers": ["sharepoint"],
  "permissions": {
    "deny": [
      "WebFetch",
      "WebSearch",
      "Read(./.env)",
      "Edit(./.env)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push --force:*)",
      "Bash(git clean:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sparr-publicering.sh"
          }
        ]
      }
    ]
  }
}

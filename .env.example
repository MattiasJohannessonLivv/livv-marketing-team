# Kopiera till .env och fyll i. .env ignoreras av Git och läses aldrig av agenterna.
# starta.sh läser in filen innan Claude Code startar.

# Microsoft 365 och SharePoint (fas 1)
# App-registrering i Entra ID med applikationsbehörigheten Sites.Selected,
# beviljad bara för webbplatsen livv-group-data-it-ai.
AZURE_TENANT_ID=fyll-i-tenant-id
AZURE_CLIENT_ID=fyll-i-client-id
AZURE_CLIENT_SECRET=fyll-i-client-secret

# driveId och rotmappen Livv Marketing Ops är låsta i mcp/sharepoint_server.py
# och kan inte ändras här, med avsikt.

# Publicering från teamtavlan när Mattias klickar Publicera. Läses bara av tavla.sh,
# aldrig av agenterna. Utan värden är knappen avstängd.

# LinkedIn: appen på linkedin.com/developers med Community Management API.
# Redirect URL i appen: http://localhost:8787/linkedin/svar
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Företagssidor som går att välja som avsändare: namn=organisations-id, separerade med ;
# Lägg till Livv.fi här när den ska användas, till exempel Livv.se=42934065;Livv.fi=12345678
LINKEDIN_SIDOR=Livv.se=42934065
LINKEDIN_STANDARD_SIDA=Livv.se
# Inloggningen görs i tavlan och sparas i .env.linkedin. Den går ut efter 60 dagar.

# X: utvecklarappen för Livv Groups konto, med behörigheten Read and write.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_KONTO=Livv Group

# Nycklar för Google, Meta och xAI läggs till i fas 2 och 3.
